# .env.example: copy this file to .env, then paste your key after the = sign.
#   cp .env.example .env
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
# NEVER commit, share or screenshot your .env file. .gitignore keeps it out of git.
GEMINI_API_KEY=

# Optional: uncomment if Docker has less than 6 GB of memory (setup.sh tells you).
# Uses 1 worker instead of 2. Everything still works, including Step 4.
# LOW_MEMORY=1

# Optional: uncomment and change if port 8080 is already in use on your computer.
# UI_PORT=8080
